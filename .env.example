# Porta do servidor (serve a API e o app compilado)
PORT=3000

# Onde fica o banco SQLite. Em Docker, monte um volume neste caminho.
DATA_DIR=./data

# Em producao o cookie de sessao e marcado Secure, o que exige HTTPS. Para
# testar producao em localhost (sem HTTPS), defina INSECURE_COOKIES=1.
# INSECURE_COOKIES=1

# Codigo que a segunda pessoa usa para criar a conta. O primeiro cadastro
# nao precisa de codigo; depois dele, ninguem entra sem este valor.
INVITE_CODE=troque-isto

# De quantas em quantas horas reconsultar o preco dos itens que estao nas
# listas. 0 desliga.
REFRESH_HOURS=12

# Por quanto tempo reaproveitar o resultado de uma busca antes de bater nos
# sites de novo (minutos).
SEARCH_TTL_MINUTES=360

# Loja usada em cada rede -- preco e estoque variam por loja.
# Condor: o id sai do site (padrao: Curitiba, Nilo Pecanha).
CONDOR_STORE_ID=1441
# As contas VTEX raramente mudam; ficam aqui para nao precisar mexer no codigo.
# ANGELONI_HOST=superangeloni.vtexcommercestable.com.br
# FESTVAL_HOST=meufestval.vtexcommercestable.com.br
# MUFFATO_HOST=www.supermuffato.com.br
